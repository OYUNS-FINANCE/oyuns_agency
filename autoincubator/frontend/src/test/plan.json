  "engine_formulas": [
    {
      "key": "arpa",
      "label": "ARPA",
      "formula": "Σ tier price * tier mix",
      "inputs": ["mix", "price_monthly"]
    },
    {
      "key": "variable_cost_per_customer",
      "label": "Variable cost per customer",
      "formula": "variable cost per customer + ARPA * payment fee",
      "inputs": ["mix", "payment_fee_pct", "price_monthly", "variable_cost_per_customer"]
    },
    {
      "key": "gross_margin_pct",
      "label": "Gross margin",
      "formula": "(ARPA - variable cost per customer) / ARPA",
      "inputs": ["mix", "payment_fee_pct", "price_monthly", "variable_cost_per_customer"]
    },
    {
      "key": "blended_cac",
      "label": "Blended CAC",
      "formula": "Σ channel spend / Σ (channel spend / channel CAC)",
      "inputs": ["channel_cac", "channel_spend"]
    },
    {
      "key": "ltv",
      "label": "LTV",
      "formula": "ARPA * gross margin / monthly churn",
      "inputs": [
        "mix",
        "monthly_churn",
        "payment_fee_pct",
        "price_monthly",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "ltv_to_cac",
      "label": "LTV:CAC",
      "formula": "LTV / blended CAC",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "mix",
        "monthly_churn",
        "payment_fee_pct",
        "price_monthly",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "payback_months",
      "label": "Payback (months)",
      "formula": "blended CAC / (ARPA * gross margin)",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "mix",
        "payment_fee_pct",
        "price_monthly",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "channels.new_customers_per_month",
      "label": "New customers per channel",
      "formula": "channel spend / channel CAC",
      "inputs": ["channel_cac", "channel_spend"]
    },
    {
      "key": "months.signups",
      "label": "Signups",
      "formula": "organic signups * (1 + organic growth)^(month - launch month)",
      "inputs": ["launch_month", "organic_growth", "organic_signups_m1"]
    },
    {
      "key": "months.new_customers",
      "label": "New customers",
      "formula": "signups * free-to-paid + Σ paid new customers",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "free_to_paid",
        "launch_month",
        "organic_growth",
        "organic_signups_m1"
      ]
    },
    {
      "key": "months.customers",
      "label": "Customers",
      "formula": "previous customers * (1 - churn) + new customers",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "free_to_paid",
        "launch_month",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1"
      ]
    },
    {
      "key": "months.mrr",
      "label": "MRR",
      "formula": "customers * ARPA",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "free_to_paid",
        "launch_month",
        "mix",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1",
        "price_monthly"
      ]
    },
    {
      "key": "months.cogs",
      "label": "COGS",
      "formula": "customers * variable cost per customer",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "free_to_paid",
        "launch_month",
        "mix",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1",
        "payment_fee_pct",
        "price_monthly",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "months.gross_profit",
      "label": "Gross profit",
      "formula": "MRR - COGS",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "free_to_paid",
        "launch_month",
        "mix",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1",
        "payment_fee_pct",
        "price_monthly",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "months.opex",
      "label": "Opex",
      "formula": "Σ fixed costs + Σ channel spend (from launch)",
      "inputs": ["channel_spend", "fixed_costs", "launch_month"]
    },
    {
      "key": "months.net_cash_flow",
      "label": "Net cash flow",
      "formula": "gross profit - opex",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "fixed_costs",
        "free_to_paid",
        "launch_month",
        "mix",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1",
        "payment_fee_pct",
        "price_monthly",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "months.cash",
      "label": "Cash",
      "formula": "previous cash + net cash flow",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "fixed_costs",
        "free_to_paid",
        "launch_month",
        "mix",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1",
        "payment_fee_pct",
        "price_monthly",
        "starting_cash",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "break_even_month",
      "label": "Break-even month",
      "formula": "first month with net cash flow of 0 or more",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "fixed_costs",
        "free_to_paid",
        "launch_month",
        "mix",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1",
        "payment_fee_pct",
        "price_monthly",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "cash_out_month",
      "label": "Cash-out month",
      "formula": "first month with cash < 0",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "fixed_costs",
        "free_to_paid",
        "launch_month",
        "mix",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1",
        "payment_fee_pct",
        "price_monthly",
        "starting_cash",
        "variable_cost_per_customer"
      ]
    },
    {
      "key": "runway_after_m12",
      "label": "Runway after month 12",
      "formula": "month-12 cash / month-12 burn",
      "inputs": [
        "channel_cac",
        "channel_spend",
        "fixed_costs",
        "free_to_paid",
        "launch_month",
        "mix",
        "monthly_churn",
        "organic_growth",
        "organic_signups_m1",
        "payment_fee_pct",
        "price_monthly",
        "starting_cash",
        "variable_cost_per_customer"
      ]
    }
  ]
