# Variables for docker-compose.prod.yml. In Dokploy, paste these into the Compose service's
# Environment tab; never commit real values.

DOMAIN=app.example.com                 # DNS A record -> the VPS
POSTGRES_USER=autoincubator
POSTGRES_PASSWORD=                     # openssl rand -hex 24
POSTGRES_DB=autoincubator

# htpasswd line with every $ doubled for compose, e.g.
#   echo $(htpasswd -nbB me 'password') | sed -e 's/\$/\$\$/g'
BASIC_AUTH_USERS=

LLM_PROVIDER=anthropic
SEARCH_PROVIDER=tavily
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=
# Encrypts API keys entered on the Models settings page. Required; losing it means re-entering them.
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SETTINGS_ENCRYPTION_KEY=
TAVILY_API_KEY=
SERPER_API_KEY=
DAILY_COST_CAP_USD=25

# Optional
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
BACKUP_HOUR_UTC=03
BACKUP_KEEP_DAYS=14
RCLONE_REMOTE=                         # e.g. R2:my-bucket/autoincubator; empty = local dumps only
RCLONE_CONFIG_R2_ACCESS_KEY_ID=
RCLONE_CONFIG_R2_SECRET_ACCESS_KEY=
RCLONE_CONFIG_R2_ENDPOINT=             # https://<account>.r2.cloudflarestorage.com
