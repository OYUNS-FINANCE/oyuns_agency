# Copy to .env (repo root). Backend reads it via pydantic-settings.

# Docker Compose
POSTGRES_USER=autoincubator
POSTGRES_PASSWORD=autoincubator
POSTGRES_DB=autoincubator

# Backend
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://autoincubator:autoincubator@localhost:5432/autoincubator
REDIS_URL=redis://localhost:6379/0
ARQ_QUEUE_NAME=arq:queue
DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001   # owner of all rows until auth exists

# LLM / search providers. fake + mock run fully offline (no network, no key).
LLM_PROVIDER=fake                 # fake | anthropic | openai
SEARCH_PROVIDER=mock              # mock | tavily | serper
ANTHROPIC_API_KEY=                # required when LLM_PROVIDER=anthropic
OPENAI_API_KEY=                   # required when LLM_PROVIDER=openai (agent models without an explicit *_MODEL become gpt-5 / gpt-5-mini)
TAVILY_API_KEY=                   # required when SEARCH_PROVIDER=tavily
SERPER_API_KEY=                   # required when SEARCH_PROVIDER=serper
# Per-agent routing (ADR 0008): cheap Scout, strong Skeptic and Editor
SCOUT_MODEL=claude-haiku-5-5
ANALYST_MODEL=claude-sonnet-5-5
SKEPTIC_MODEL=claude-opus-5-5
PRODUCT_ARCHITECT_MODEL=claude-sonnet-5-5
GTM_STRATEGIST_MODEL=claude-sonnet-5-5
FINANCIAL_MODELER_MODEL=claude-sonnet-5-5
EDITOR_MODEL=claude-opus-5-5
LLM_PROMPT_CACHING=true           # cache system prompts (and the first turn on retries)
LLM_MAX_VALIDATION_RETRIES=2
FAKE_LLM_LATENCY_MS=0             # delay per fake LLM call: makes offline runs watchable live

# Phase-1 graph
QUALITY_THRESHOLD=6.0             # composite score (1-10) an idea needs to be viable
MAX_SCOUT_ITERATIONS=2            # first pass + at most one loop back
MIN_VIABLE_IDEAS=3
MAX_BRIEFS=5
SCOUT_TARGET_CANDIDATES=10
DEDUP_THRESHOLD=0.6               # Jaccard similarity at which candidates count as duplicates
AGENT_CONCURRENCY=4

# Skeptic rubric weights (normalised; 0 removes a dimension)
RUBRIC_WEIGHT_CAC_RISK=1
RUBRIC_WEIGHT_CHANNEL_DEPENDENCY=1
RUBRIC_WEIGHT_CHURN_RISK=1
RUBRIC_WEIGHT_DEFENSIBILITY=1
RUBRIC_WEIGHT_REGULATORY_RISK=1
RUBRIC_WEIGHT_TIME_TO_FIRST_REVENUE=1
RUBRIC_WEIGHT_SOLO_FOUNDER_FEASIBILITY=1

# Runs: per-run budget, worker leases, streaming (ADR 0004 / 0003)
RUN_MAX_TOKENS=2000000            # LLM tokens per run; a request may only lower it
RUN_MAX_SEARCHES=300              # search-provider calls per run (cache hits are free)
RUN_JOB_TIMEOUT_S=3600
RUN_LEASE_TTL_S=60                # a run whose worker stops renewing for this long is recovered
SSE_POLL_INTERVAL_S=5             # fallback poll if a NOTIFY is missed

DAILY_COST_CAP_USD=25             # LLM spend per UTC day, all runs; 0 = off (ADR 0008)

# Search (ADR 0008)
SEARCH_TIMEOUT_S=15
SEARCH_MAX_RETRIES=3              # backoff on 429/5xx, honours Retry-After
SEARCH_RATE_PER_S=5               # provider calls per second, per process
SEARCH_CACHE_TTL_S=86400          # cross-run cache of provider answers; 0 = off
SEARCH_SNIPPET_MAX_CHARS=1200
SEARCH_TITLE_MAX_CHARS=200
PAGE_FETCH_TIMEOUT_S=20           # grounding eval page fetches
PAGE_FETCH_MAX_BYTES=2000000

# Rate limiting of public endpoints, per client (ADR 0008)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RUNS_PER_HOUR=10       # POST /runs
RATE_LIMIT_LLM_PER_MINUTE=20      # cowork chat/re-score/merge, select
RATE_LIMIT_API_PER_MINUTE=300     # everything else except SSE and health
TRUSTED_PROXY_HOPS=0              # proxies appending X-Forwarded-For (prod compose sets 1: Traefik)

# Tracing (ADR 0008): OTLP/HTTP; unset = off. A run's trace id is its run id.
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. http://localhost:4318 (Jaeger)
OTEL_SERVICE_NAME=autoincubator
SENTRY_DSN=                       # unset = off (ADR 0009)

# Co-working at the checkpoint (ADR 0006)
COWORK_REPLY_TIMEOUT_S=300        # a chat reply still pending after this is reported failed
REJECTED_REASONS_MAX=20           # rejection reasons kept in the founder profile for Mode B

# Frontend (server-side rewrite target for /api/*)
BACKEND_URL=http://localhost:8000
